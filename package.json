{
  "name": "@ours.network/cowork",
  "version": "1.0.5",
  "description": "Durable ours mission rooms on the shared ours daemon.",
  "type": "module",
  "license": "FSL-1.1-Apache-2.0",
  "bin": {
    "ours-cowork": "dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "docs/*.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:web": "tsc -p web/tsconfig.json --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.mjs",
    "test:web": "vitest run",
    "test:browser": "node --test tests/browser-smoke.test.mjs",
    "test:release": "node --test tests/static-gates.test.mjs"
  },
  "dependencies": {
    "@ours.network/sdk": "3.5.0",
    "better-sqlite3": "11.10.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@adapt-toolkit/broker": "0.10.12",
    "@ours.network/cli": "2.5.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.14.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "esbuild": "0.25.0",
    "jsdom": "25.0.1",
    "playwright-core": "1.60.0",
    "tsx": "4.23.1",
    "typescript": "^5.5.4",
    "vite": "6.4.3",
    "vitest": "3.2.6"
  }
}
